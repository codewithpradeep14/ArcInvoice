# ArcInvoice Environment Configuration Template

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Server-only secret key (optional if using Security Definer RPCs, recommended for admin overrides)
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# Arc Blockchain Configuration (Mainnet defaults)
# Chain ID 5042 = Arc Mainnet | 5042002 = Arc Testnet
NEXT_PUBLIC_ARC_CHAIN_ID=5042
ARC_RPC_URL=https://rpc.mainnet.arc.io
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.mainnet.arc.io
NEXT_PUBLIC_ARC_EXPLORER_URL=https://explorer.arc.io
# Arc native USDC ERC-20 Interface Address
NEXT_PUBLIC_USDC_CONTRACT_ADDRESS=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_USDC_DECIMALS=6

# Cron and Reconciliation Security
CRON_SECRET=super-secret-cron-token-change-in-production
